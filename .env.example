# App Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./insureops.db
# DATABASE_URL=postgresql+psycopg2://insureops:insureops_secret@localhost:5432/insureops
POSTGRES_USER=insureops
POSTGRES_PASSWORD=insureops_secret
POSTGRES_DB=insureops

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM / OpenAI API (Optional / Mock mode by default)
OPENAI_API_KEY=
LLM_PROVIDER=mock
